      "source": [
        "---\n",
        "title: \"NASDAQ Historical Stock Market Analytics\"\n",
        "author: \"NASDAQ Dataset Builder\"\n",
        "date: today\n",
        "format:\n",
        "  html:\n",
        "    theme: slate\n",
        "    page-layout: full\n",
        "    toc: true\n",
        "    toc-depth: 3\n",
        "    embed-resources: true\n",
        "execute:\n",
        "  echo: false\n",
        "  warning: false\n",
        "---\n",
        "\n",
        "<!-- Premium Custom Styling -->\n",
        "<style>\n",
        "  @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap');\n",
        "  \n",
        "  body {\n",
        "    background-color: #0b0f19;\n",
        "    color: #e2e8f0;\n",
        "    font-family: 'Outfit', 'Inter', sans-serif;\n",
        "  }\n",
        "  \n",
        "  h1, h2, h3, h4, h5, h6 {\n",
        "    font-family: 'Outfit', sans-serif;\n",
        "    font-weight: 700;\n",
        "    letter-spacing: -0.5px;\n",
        "  }\n",
        "  \n",
        "  .title-block-header {\n",
        "    background: linear-gradient(135deg, #0f172a 0%, #020617 100%);\n",
        "    border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n",
        "    padding: 2.5rem;\n",
        "    margin-bottom: 2rem;\n",
        "    border-radius: 16px;\n",
        "    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);\n",
        "  }\n",
        "  \n",
        "  .quarto-title .title {\n",
        "    background: linear-gradient(to right, #00f2fe, #4facfe);\n",
        "    -webkit-background-clip: text;\n",
        "    -webkit-text-fill-color: transparent;\n",
        "    font-size: 2.8rem;\n",
        "    font-weight: 800;\n",
        "  }\n",
        "  \n",
        "  /* Glassmorphism Cards */\n",
        "  .custom-card {\n",
        "    background: rgba(22, 28, 45, 0.65);\n",
        "    border: 1px solid rgba(255, 255, 255, 0.08);\n",
        "    border-radius: 16px;\n",
        "    padding: 1.75rem;\n",
        "    margin-bottom: 2rem;\n",
        "    backdrop-filter: blur(16px);\n",
        "    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);\n",
        "  }\n",
        "  \n",
        "  .insight-card {\n",
        "    border-left: 4px solid #38bdf8;\n",
        "    background: rgba(56, 189, 248, 0.04);\n",
        "  }\n",
        "  \n",
        "  /* Tables styling */\n",
        "  .table-responsive {\n",
        "    overflow-x: auto;\n",
        "    margin: 1.5rem 0;\n",
        "  }\n",
        "  \n",
        "  table.table {\n",
        "    border-collapse: collapse !important;\n",
        "    width: 100% !important;\n",
        "    background-color: transparent !important;\n",
        "  }\n",
        "  \n",
        "  table.table th {\n",
        "    background-color: rgba(30, 41, 59, 0.9) !important;\n",
        "    color: #f1f5f9 !important;\n",
        "    font-family: 'Outfit', sans-serif;\n",
        "    font-weight: 600;\n",
        "    font-size: 0.9rem;\n",
        "    text-transform: uppercase;\n",
        "    letter-spacing: 0.5px;\n",
        "    padding: 12px 16px !important;\n",
        "    border-bottom: 2px solid rgba(255, 255, 255, 0.15) !important;\n",
        "  }\n",
        "  \n",
        "  table.table td {\n",
        "    padding: 12px 16px !important;\n",
        "    border-bottom: 1px solid rgba(255, 255, 255, 0.06) !important;\n",
        "    font-size: 0.95rem;\n",
        "    color: #cbd5e1 !important;\n",
        "    vertical-align: middle !important;\n",
        "  }\n",
        "  \n",
        "  table.table tr:hover td {\n",
        "    background-color: rgba(255, 255, 255, 0.03) !important;\n",
        "    color: #ffffff !important;\n",
        "  }\n",
        "  \n",
        "  /* Badges */\n",
        "  .badge-ticker {\n",
        "    font-weight: 800;\n",
        "    font-size: 0.85rem;\n",
        "    background: rgba(56, 189, 248, 0.15);\n",
        "    color: #38bdf8;\n",
        "    padding: 0.25rem 0.5rem;\n",
        "    border-radius: 6px;\n",
        "    border: 1px solid rgba(56, 189, 248, 0.3);\n",
        "  }\n",
        "  \n",
        "  .trend-up {\n",
        "    color: #10b981 !important;\n",
        "    font-weight: 600;\n",
        "  }\n",
        "  \n",
        "  .trend-down {\n",
        "    color: #ef4444 !important;\n",
        "    font-weight: 600;\n",
        "  }\n",
        "  \n",
        "  /* Tabs styling */\n",
        "  .nav-tabs {\n",
        "    border-bottom: 1px solid rgba(255, 255, 255, 0.08) !important;\n",
        "    margin-bottom: 1.5rem !important;\n",
        "    gap: 0.5rem;\n",
        "  }\n",
        "  \n",
        "  .nav-tabs .nav-link {\n",
        "    color: #94a3b8 !important;\n",
        "    background-color: transparent !important;\n",
        "    border: 1px solid transparent !important;\n",
        "    border-radius: 8px 8px 0 0 !important;\n",
        "    font-weight: 600 !important;\n",
        "    font-size: 0.95rem !important;\n",
        "    padding: 0.75rem 1.25rem !important;\n",
        "    transition: all 0.25s !important;\n",
        "  }\n",
        "  \n",
        "  .nav-tabs .nav-link:hover {\n",
        "    color: #f1f5f9 !important;\n",
        "    background-color: rgba(255, 255, 255, 0.03) !important;\n",
        "  }\n",
        "  \n",
        "  .nav-tabs .nav-link.active {\n",
        "    color: #38bdf8 !important;\n",
        "    background-color: rgba(56, 189, 248, 0.06) !important;\n",
        "    border-color: rgba(255, 255, 255, 0.08) !important;\n",
        "    border-bottom-color: #0b0f19 !important;\n",
        "    box-shadow: 0 -4px 10px rgba(56, 189, 248, 0.05);\n",
        "  }\n",
        "</style>\n",
        "\n",
        "## Overview\n",
        "\n",
        "This report provides a dynamic, interactive dashboard that aggregates 10 years of historical stock data from NASDAQ. It quantifies the speed, frequency, and magnitude of price changes (volatility) for ten major watchlisted companies, offering professional, sector-focused financial insights.\n",
        "\n",
        "---\n",
        "\n",
        "## Price Volatility & Rapidity Analysis\n",
        "\n",
        "\"Rapidity of price change\" measures how fast and widely stock values fluctuate. Below is the historical ranking of the watchlisted companies, sorted from **most volatile** (fastest changing) to **most stable** (slowest changing).\n",
        "\n",
        "::: {.custom-card}\n",
        "### Rapidity & Volatility Ranking Table\n",
        "::: {.table-responsive}"
      ],
      "id": "c067a523"
    },
    {
      "cell_type": "code",
      "metadata": {
        "results": "asis"
      },
      "source": [
        "#| echo: false\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "\n",
        "summary_file = \"downloads/volatility_summary.csv\"\n",
        "if os.path.exists(summary_file):\n",
        "    df_vol = pd.read_csv(summary_file)\n",
        "    \n",
        "    # Rename columns slightly for clean table headers\n",
        "    df_vol = df_vol.rename(columns={\n",
        "        \"Avg Daily Move (%)\": \"Avg. Daily Move\",\n",
        "        \"Intraday Swing (%)\": \"Avg. Intraday Swing\",\n",
        "        \"Annualized Volatility (%)\": \"Annualized Volatility\",\n",
        "        \"Max Daily Gain (%)\": \"Max Daily Gain\",\n",
        "        \"Max Daily Loss (%)\": \"Max Daily Loss\"\n",
        "    })\n",
        "    \n",
        "    # Format values as percentages with clean signs\n",
        "    df_vol[\"Avg. Daily Move\"] = df_vol[\"Avg. Daily Move\"].map(\"{:.2f}%\".format)\n",
        "    df_vol[\"Avg. Intraday Swing\"] = df_vol[\"Avg. Intraday Swing\"].map(\"{:.2f}%\".format)\n",
        "    df_vol[\"Annualized Volatility\"] = df_vol[\"Annualized Volatility\"].map(\"{:.2f}%\".format)\n",
        "    df_vol[\"Max Daily Gain\"] = df_vol[\"Max Daily Gain\"].map(\"{:+.2f}%\".format)\n",
        "    df_vol[\"Max Daily Loss\"] = df_vol[\"Max Daily Loss\"].map(\"{:+.2f}%\".format)\n",
        "    \n",
        "    # Render table manually with custom CSS classes applied\n",
        "    print(\"<table class='table table-striped table-hover'>\")\n",
        "    print(\"<thead><tr>\")\n",
        "    print(\"<th>Ticker</th><th>Company Name</th><th>Avg. Daily Move</th><th>Avg. Intraday Swing</th><th>Annualized Volatility</th><th>Max Daily Gain</th><th>Max Daily Loss</th>\")\n",
        "    print(\"</tr></thead><tbody>\")\n",
        "    \n",
        "    for idx, row in df_vol.iterrows():\n",
        "        print(\"<tr>\")\n",
        "        print(f\"<td><span class='badge-ticker'>{row['Ticker']}</span></td>\")\n",
        "        print(f\"<td><strong>{row['Company']}</strong></td>\")\n",
        "        print(f\"<td>{row['Avg. Daily Move']}</td>\")\n",
        "        print(f\"<td>{row['Avg. Intraday Swing']}</td>\")\n",
        "        print(f\"<td style='color:#38bdf8; font-weight:700;'>{row['Annualized Volatility']}</td>\")\n",
        "        print(f\"<td class='trend-up'>{row['Max Daily Gain']}</td>\")\n",
        "        print(f\"<td class='trend-down'>{row['Max Daily Loss']}</td>\")\n",
        "        print(\"</tr>\")\n",
        "        \n",
        "    print(\"</tbody></table>\")\n",
        "else:\n",
        "    print(\"<div class='alert alert-warning'>Volatility summary file not found. Run analyze_volatility.py first.</div>\")"
      ],
      "id": "1e4071a7",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        ":::\n",
        "\n",
        "### Visualizing Volatility Profiles\n",
        "\n",
        "To compare the volatility profiles of each company, we plot **Annualized Volatility** alongside **Average Intraday Price Swings**. This chart ranks the companies by overall price velocity and displays how much price action happens *within* a single trading session.\n",
        "\n",
        "::: {.custom-card}"
      ],
      "id": "7466d5c4"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| label: volatility-plot\n",
        "#| echo: false\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "summary_file = \"downloads/volatility_summary.csv\"\n",
        "if os.path.exists(summary_file):\n",
        "    df = pd.read_csv(summary_file)\n",
        "    # Sort ascending for horizontal bar chart rendering from top (highest) to bottom\n",
        "    df_sorted = df.sort_values(by=\"Annualized Volatility (%)\", ascending=True)\n",
        "    \n",
        "    # Create a side-by-side or dual horizontal bar chart\n",
        "    fig = make_subplots(\n",
        "        rows=1, cols=2,\n",
        "        subplot_titles=(\"Annualized Volatility (Overall Speed)\", \"Avg. Intraday Swing (Day-Trading Spans)\"),\n",
        "        shared_yaxes=True,\n",
        "        horizontal_spacing=0.08\n",
        "    )\n",
        "    \n",
        "    # Color mapping gradient for the bars\n",
        "    # Low volatility (CSCO ~25%) -> Cool Teal, High volatility (TSLA ~59%) -> Hot Crimson\n",
        "    color_values = df_sorted[\"Annualized Volatility (%)\"]\n",
        "    \n",
        "    # Add Annualized Volatility Bar\n",
        "    fig.add_trace(\n",
        "        go.Bar(\n",
        "            y=df_sorted[\"Company\"],\n",
        "            x=df_sorted[\"Annualized Volatility (%)\"],\n",
        "            orientation='h',\n",
        "            name=\"Annualized Volatility\",\n",
        "            marker=dict(\n",
        "                color=color_values,\n",
        "                colorscale=\"bluered\",\n",
        "                line=dict(color='rgba(255, 255, 255, 0.1)', width=1)\n",
        "            ),\n",
        "            hovertemplate=\"Company: %{y}<br>Annualized Volatility: %{x:.2f}%<extra></extra>\",\n",
        "            text=df_sorted[\"Annualized Volatility (%)\"].map(\"{:.1f}%\".format),\n",
        "            textposition='inside',\n",
        "            insidetextanchor='end'\n",
        "        ),\n",
        "        row=1, col=1\n",
        "    )\n",
        "    \n",
        "    # Add Intraday Swing Bar\n",
        "    fig.add_trace(\n",
        "        go.Bar(\n",
        "            y=df_sorted[\"Company\"],\n",
        "            x=df_sorted[\"Intraday Swing (%)\"],\n",
        "            orientation='h',\n",
        "            name=\"Intraday Swing\",\n",
        "            marker=dict(\n",
        "                color=df_sorted[\"Intraday Swing (%)\"],\n",
        "                colorscale=\"portland\",\n",
        "                line=dict(color='rgba(255, 255, 255, 0.1)', width=1)\n",
        "            ),\n",
        "            hovertemplate=\"Company: %{y}<br>Intraday Swing: %{x:.2f}%<extra></extra>\",\n",
        "            text=df_sorted[\"Intraday Swing (%)\"].map(\"{:.1f}%\".format),\n",
        "            textposition='inside',\n",
        "            insidetextanchor='end'\n",
        "        ),\n",
        "        row=1, col=2\n",
        "    )\n",
        "    \n",
        "    fig.update_layout(\n",
        "        template=\"plotly_dark\",\n",
        "        height=500,\n",
        "        margin=dict(l=10, r=20, t=40, b=40),\n",
        "        showlegend=False,\n",
        "        plot_bgcolor=\"#0f172a\",\n",
        "        paper_bgcolor=\"#0b0f19\",\n",
        "        yaxis=dict(\n",
        "            tickfont=dict(size=12, family=\"Outfit\"),\n",
        "        ),\n",
        "        xaxis=dict(\n",
        "            title=\"Volatility (%)\",\n",
        "            gridcolor=\"rgba(255, 255, 255, 0.05)\",\n",
        "            ticksuffix=\"%\"\n",
        "        ),\n",
        "        xaxis2=dict(\n",
        "            title=\"Swing (%)\",\n",
        "            gridcolor=\"rgba(255, 255, 255, 0.05)\",\n",
        "            ticksuffix=\"%\"\n",
        "        )\n",
        "    )\n",
        "    \n",
        "    fig.show()\n",
        "else:\n",
        "    print(\"<div class='alert alert-warning'>Volatility summary file not found.</div>\")"
      ],
      "id": "volatility-plot",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        ":::\n",
        "\n",
        "::: {.custom-card .insight-card}\n",
        "### Educated Volatility Insights & Trend Analysis\n",
        "\n",
        "An analysis of the 10-year volatility data reveals several structural trends:\n",
        "\n",
        "1. **The Beta/Volatility Hierarchy**:\n",
        "   * **High Beta Growth (TSLA, AMD)**: At the top of the spectrum sit **Tesla** and **AMD** with annualized volatilities exceeding **56-59%**. These companies are characterized by rapid product cycles (semiconductor node shifts, electric vehicle scaling), intense competition, and high valuation multiples which make their prices highly sensitive to forward-looking growth estimates and macroeconomic liquidity.\n",
        "   * **Growth Tech (NFLX, QCOM, META, AMZN)**: These companies sit in a middle band of **32-41%** volatility. While they are massive cash-flow engines, their stock prices are heavily impacted by discrete growth parameters (Netflix subscriber updates, Meta ad spend, Amazon margins).\n",
        "   * **Enterprise & Diversified Value (SBUX, AAPL, MSFT, CSCO)**: Sitting below **30%** volatility, these businesses have massive scale, recurring revenue models (cloud subscriptions, product ecosystem lock-in, global retail footprints), and huge stock buyback programs that act as price shock-absorbers.\n",
        "\n",
        "2. **The Intraday vs. Interday Swing Ratio**:\n",
        "   * For **Tesla (TSLA)** and **AMD**, the average intraday range is **4.2%**, but their daily close-to-close move is **~2.5-2.6%**. This implies that these assets experience heavy \"noise\" and trading volume *during* the trading day (day-trading momentum), where prices swing widely but often settle closer to the previous day's close.\n",
        "   * In contrast, mature assets like **Microsoft (MSFT)** have a very tight intraday swing (**1.9%**) and daily move (**1.18%**), indicating orderly, institutional trading flows with minimal speculative spikes.\n",
        "\n",
        "3. **Asymmetric Tail Risk (Extreme Earnings Gaps)**:\n",
        "   * Volatility is not always symmetrical. Looking at **Netflix (NFLX)** and **Meta (META)**, their maximum single-day drawdowns (**-35.12%** and **-26.39%** respectively) are significantly larger than their annualized volatility would predict. This points to the phenomenon of **\"gap risk\"**—where major growth revisions trigger massive capital re-allocations instantly, bypassing normal daily trading ranges. \n",
        ":::\n",
        "\n",
        "---\n",
        "\n",
        "## Detailed Stock Ingestion Charts\n",
        "\n",
        "::: {.custom-card}\n",
        "Select a tab below to view interactive historical price and volume charting (10-year limit) for each company, styled similarly to NASDAQ's Advanced Charting interface."
      ],
      "id": "edd36fae"
    },
    {
      "cell_type": "code",
      "metadata": {
        "results": "asis"
      },
      "source": [
        "#| echo: false\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "\n",
        "downloads_dir = \"downloads\"\n",
        "ticker_names = {\n",
        "    \"AAPL\": \"Apple (AAPL)\",\n",
        "    \"MSFT\": \"Microsoft (MSFT)\",\n",
        "    \"AMZN\": \"Amazon (AMZN)\",\n",
        "    \"TSLA\": \"Tesla (TSLA)\",\n",
        "    \"META\": \"Meta (META)\",\n",
        "    \"AMD\": \"AMD (AMD)\",\n",
        "    \"NFLX\": \"Netflix (NFLX)\",\n",
        "    \"SBUX\": \"Starbucks (SBUX)\",\n",
        "    \"CSCO\": \"Cisco (CSCO)\",\n",
        "    \"QCOM\": \"Qualcomm (QCOM)\"\n",
        "}\n",
        "\n",
        "if os.path.exists(downloads_dir):\n",
        "    csv_files = sorted([f for f in os.listdir(downloads_dir) if f.endswith(\"_historical.csv\")])\n",
        "    \n",
        "    if csv_files:\n",
        "        # Start Quarto Tabset\n",
        "        print(\"::: {.panel-tabset}\")\n",
        "        \n",
        "        for file in csv_files:\n",
        "            ticker = file.replace(\"_historical.csv\", \"\")\n",
        "            company_label = ticker_names.get(ticker, f\"{ticker} Stock\")\n",
        "            file_path = os.path.join(downloads_dir, file)\n",
        "            \n",
        "            # Read and parse CSV\n",
        "            df = pd.read_csv(file_path)\n",
        "            df['date'] = pd.to_datetime(df['date'])\n",
        "            df = df.sort_values(by='date').reset_index(drop=True)\n",
        "            \n",
        "            # Identify volume direction colors (green for price gain, red for loss)\n",
        "            colors = []\n",
        "            prices = df['close'].values\n",
        "            for i in range(len(df)):\n",
        "                if i == 0:\n",
        "                    colors.append('#10b981')\n",
        "                else:\n",
        "                    if prices[i] >= prices[i-1]:\n",
        "                        colors.append('#10b981')\n",
        "                    else:\n",
        "                        colors.append('#ef4444')\n",
        "            \n",
        "            # Create subplots (Price top panel, Volume bottom panel)\n",
        "            fig = make_subplots(\n",
        "                rows=2, cols=1, \n",
        "                shared_xaxes=True, \n",
        "                vertical_spacing=0.05,\n",
        "                row_heights=[0.75, 0.25]\n",
        "            )\n",
        "            \n",
        "            # Add Area Chart for Price\n",
        "            fig.add_trace(\n",
        "                go.Scatter(\n",
        "                    x=df['date'], \n",
        "                    y=df['close'],\n",
        "                    name=\"Close Price\",\n",
        "                    line=dict(color=\"#38bdf8\", width=2),\n",
        "                    fill=\"tozeroy\",\n",
        "                    fillcolor=\"rgba(56, 189, 248, 0.1)\",\n",
        "                    hovertemplate=\"Date: %{x|%Y-%m-%d}<br>Price: $%{y:.2f}<extra></extra>\"\n",
        "                ),\n",
        "                row=1, col=1\n",
        "            )\n",
        "            \n",
        "            # Add Bar Chart for Volume\n",
        "            fig.add_trace(\n",
        "                go.Bar(\n",
        "                    x=df['date'], \n",
        "                    y=df['volume'],\n",
        "                    name=\"Volume\",\n",
        "                    marker=dict(color=colors, line=dict(width=0)),\n",
        "                    hovertemplate=\"Volume: %{y:,}<extra></extra>\"\n",
        "                ),\n",
        "                row=2, col=1\n",
        "            )\n",
        "            \n",
        "            # Styling & Range Selectors\n",
        "            fig.update_layout(\n",
        "                template=\"plotly_dark\",\n",
        "                height=550,\n",
        "                margin=dict(l=20, r=20, t=10, b=20),\n",
        "                showlegend=False,\n",
        "                hovermode=\"x unified\",\n",
        "                xaxis2=dict(\n",
        "                    rangeslider=dict(visible=False),\n",
        "                    rangeselector=dict(\n",
        "                        buttons=list([\n",
        "                            dict(count=1, label=\"1Y\", step=\"year\", stepmode=\"backward\"),\n",
        "                            dict(count=5, label=\"5Y\", step=\"year\", stepmode=\"backward\"),\n",
        "                            dict(step=\"all\", label=\"MAX (10Y)\")\n",
        "                        ]),\n",
        "                        font=dict(color=\"#ffffff\"),\n",
        "                        bgcolor=\"rgba(30, 41, 59, 0.8)\",\n",
        "                        activecolor=\"#38bdf8\"\n",
        "                    ),\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\"\n",
        "                ),\n",
        "                xaxis=dict(\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\"\n",
        "                ),\n",
        "                yaxis=dict(\n",
        "                    title=\"Stock Price ($)\",\n",
        "                    side=\"right\",\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\",\n",
        "                    tickprefix=\"$\",\n",
        "                    tickformat=\".2f\"\n",
        "                ),\n",
        "                yaxis2=dict(\n",
        "                    title=\"Volume\",\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.02)\",\n",
        "                    showticklabels=False\n",
        "                ),\n",
        "                plot_bgcolor=\"#0f172a\",\n",
        "                paper_bgcolor=\"#0b0f19\"\n",
        "            )\n",
        "            \n",
        "            # Print the tab header for Quarto\n",
        "            print(f\"### {company_label}\\n\")\n",
        "            \n",

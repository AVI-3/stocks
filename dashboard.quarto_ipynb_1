        "#| echo: false\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "import plotly.graph_objects as go\n",
        "from plotly.subplots import make_subplots\n",
        "import numpy as np\n",
        "\n",
        "downloads_dir = \"downloads\"\n",
        "ticker_names = {\n",
        "    \"AAPL\": \"Apple (AAPL)\",\n",
        "    \"MSFT\": \"Microsoft (MSFT)\",\n",
        "    \"AMZN\": \"Amazon (AMZN)\",\n",
        "    \"TSLA\": \"Tesla (TSLA)\",\n",
        "    \"META\": \"Meta (META)\",\n",
        "    \"AMD\": \"AMD (AMD)\",\n",
        "    \"NFLX\": \"Netflix (NFLX)\",\n",
        "    \"SBUX\": \"Starbucks (SBUX)\",\n",
        "    \"CSCO\": \"Cisco (CSCO)\",\n",
        "    \"QCOM\": \"Qualcomm (QCOM)\"\n",
        "}\n",
        "\n",
        "if not os.path.exists(downloads_dir):\n",
        "    print(\"<div class='alert alert-danger'>Error: 'downloads/' directory not found. Please run build_dataset.py first.</div>\")\n",
        "else:\n",
        "    csv_files = sorted([f for f in os.listdir(downloads_dir) if f.endswith(\"_historical.csv\")])\n",
        "    \n",
        "    if not csv_files:\n",
        "        print(\"<div class='alert alert-warning'>Warning: No stock CSV data found in 'downloads/'.</div>\")\n",
        "    else:\n",
        "        print(\"## Stock Watchlist Charts\")\n",
        "        print(\"Select a tab below to view interactive historical price and volume charting (10-year limit) for each company, styled similarly to NASDAQ's Advanced Charting interface.\\n\")\n",
        "        \n",
        "        # Start Quarto Tabset\n",
        "        print(\"::: {.panel-tabset}\")\n",
        "        \n",
        "        for file in csv_files:\n",
        "            ticker = file.replace(\"_historical.csv\", \"\")\n",
        "            company_label = ticker_names.get(ticker, f\"{ticker} Stock\")\n",
        "            file_path = os.path.join(downloads_dir, file)\n",
        "            \n",
        "            # Read and parse CSV\n",
        "            df = pd.read_csv(file_path)\n",
        "            df['date'] = pd.to_datetime(df['date'])\n",
        "            df = df.sort_values(by='date').reset_index(drop=True)\n",
        "            \n",
        "            # Identify volume direction colors (green for price gain, red for loss)\n",
        "            colors = []\n",
        "            prices = df['close'].values\n",
        "            for i in range(len(df)):\n",
        "                if i == 0:\n",
        "                    colors.append('#10b981')  # default green for first entry\n",
        "                else:\n",
        "                    if prices[i] >= prices[i-1]:\n",
        "                        colors.append('#10b981')\n",
        "                    else:\n",
        "                        colors.append('#ef4444')\n",
        "            \n",
        "            # Create subplots (Price top panel, Volume bottom panel)\n",
        "            fig = make_subplots(\n",
        "                rows=2, cols=1, \n",
        "                shared_xaxes=True, \n",
        "                vertical_spacing=0.05,\n",
        "                row_heights=[0.75, 0.25]\n",
        "            )\n",
        "            \n",
        "            # Add Area Chart for Price (Scatter with fill to y=0)\n",
        "            fig.add_trace(\n",
        "                go.Scatter(\n",
        "                    x=df['date'], \n",
        "                    y=df['close'],\n",
        "                    name=\"Close Price\",\n",
        "                    line=dict(color=\"#38bdf8\", width=2),\n",
        "                    fill=\"tozeroy\",\n",
        "                    fillcolor=\"rgba(56, 189, 248, 0.1)\",\n",
        "                    hovertemplate=\"Date: %{x|%Y-%m-%d}<br>Price: $%{y:.2f}<extra></extra>\"\n",
        "                ),\n",
        "                row=1, col=1\n",
        "            )\n",
        "            \n",
        "            # Add Bar Chart for Volume\n",
        "            fig.add_trace(\n",
        "                go.Bar(\n",
        "                    x=df['date'], \n",
        "                    y=df['volume'],\n",
        "                    name=\"Volume\",\n",
        "                    marker=dict(color=colors, line=dict(width=0)),\n",
        "                    hovertemplate=\"Volume: %{y:,}<extra></extra>\"\n",
        "                ),\n",
        "                row=2, col=1\n",
        "            )\n",
        "            \n",
        "            # Styling & Range Selectors (similar to Nasdaq advanced charting)\n",
        "            fig.update_layout(\n",
        "                template=\"plotly_dark\",\n",
        "                height=600,\n",
        "                margin=dict(l=20, r=20, t=20, b=20),\n",
        "                showlegend=False,\n",
        "                hovermode=\"x unified\",\n",
        "                xaxis2=dict(\n",
        "                    rangeslider=dict(visible=False),\n",
        "                    rangeselector=dict(\n",
        "                        buttons=list([\n",
        "                            dict(count=1, label=\"1Y\", step=\"year\", stepmode=\"backward\"),\n",
        "                            dict(count=5, label=\"5Y\", step=\"year\", stepmode=\"backward\"),\n",
        "                            dict(step=\"all\", label=\"MAX (10Y)\")\n",
        "                        ]),\n",
        "                        font=dict(color=\"#ffffff\"),\n",
        "                        bgcolor=\"rgba(30, 41, 59, 0.8)\",\n",
        "                        activecolor=\"#38bdf8\"\n",
        "                    ),\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\"\n",
        "                ),\n",
        "                xaxis=dict(\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\"\n",
        "                ),\n",
        "                yaxis=dict(\n",
        "                    title=\"Stock Price ($)\",\n",
        "                    side=\"right\",\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.05)\",\n",
        "                    tickprefix=\"$\",\n",
        "                    tickformat=\".2f\"\n",
        "                ),\n",
        "                yaxis2=dict(\n",
        "                    title=\"Volume\",\n",
        "                    gridcolor=\"rgba(255, 255, 255, 0.02)\",\n",
        "                    showticklabels=False\n",
        "                ),\n",
        "                plot_bgcolor=\"#0b0f19\",\n",
        "                paper_bgcolor=\"#0b0f19\"\n",
        "            )\n",
        "            \n",
        "            # Print the tab header for Quarto\n",
        "            print(f\"### {company_label}\\n\")\n",
        "            \n",
        "            # Render and display the figure\n",
        "            fig.show()\n",
        "            print(\"\\n\")\n",
        "            \n",
        "        # End Quarto Tabset\n",
        "        print(\":::\")"
      ],
